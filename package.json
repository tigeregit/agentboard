{
  "name": "agentboard",
  "version": "0.1.0",
  "description": "Unified dashboard + CLI over the session history of every AI coding agent on your machine (Claude Code, Codex, Cursor, Copilot, OpenCode, Grok Build, pi, Kimi, DeepSeek Harness, Trae, WorkBuddy, MiniMax, ZCode, Gemini CLI, Qwen Code, Antigravity, Amazon Q, Kiro, Aider, Cline, Continue, PearAI, Crush, ForgeCode, Goose, llm, oh-my-pi, OpenHands, Open Interpreter, Vibe, Zed) and web chat exports.",
  "private": true,
  "type": "module",
  "bin": {
    "agentboard": "./bin/agentboard.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 4817",
    "build": "next build",
    "start": "next start -p 4817",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:update": "UPDATE_SNAPSHOTS=1 node --import tsx --test tests/*.test.ts",
    "cli": "tsx src/cli/main.ts",
    "scan": "tsx src/cli/main.ts scan",
    "demo": "tsx scripts/demo-data.ts",
    "dev:demo": "AGENTBOARD_FAKE_HOME=/tmp/agentboard-demo-home next dev -p 4817",
    "serve": "tsx src/cli/main.ts serve"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "fzstd": "^0.1.1",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
